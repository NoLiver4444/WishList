{
  "name": "wishlist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"./src/**/*.{js,jsx,css,json,html}\"",
    "format:check": "prettier --check \"./src/**/*.{js,jsx,css,json,html}\"",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "stylelint": "stylelint \"./src/**/*.css\" --allow-empty-input",
    "stylelint:fix": "stylelint \"./src/**/*.css\" --fix --allow-empty-input",
    "check": "npm run format:check && npm run lint && npm run stylelint",
    "fix": "npm run format && npm run lint:fix && npm run stylelint:fix",
    "docs": "jsdoc -c jsdoc.json",
    "setup": "npm install --legacy-peer-deps"
  },
  "dependencies": {
    "eslint-plugin-react": "^7.37.5",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "prettier": "^3.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.14.0",
    "stylelint": "^17.6.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdoc": "^4.0.5",
    "jsdoc-babel": "^0.5.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-selector-bem-pattern": "^4.0.1",
    "vite": "^7.0.4"
  }
}
