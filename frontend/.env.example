# Скопируйте в frontend/.env (для `npm run dev`) или задайте при сборке Docker-образа.

# Базовый URL API. Пусто — запросы идут на относительный /api
# (в Docker их проксирует nginx, в dev-режиме — прокси Vite).
VITE_API_URL=

# Куда dev-прокси Vite перенаправляет /api (только для `npm run dev`).
VITE_PROXY_TARGET=http://localhost:8080

# Cloudinary для загрузки картинок желаний (unsigned upload preset).
# Без них работает только добавление картинки по ссылке.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
