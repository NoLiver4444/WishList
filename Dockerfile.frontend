# Stage 1: Build React приложение
FROM node:22-alpine AS builder

WORKDIR /app

# Копируем package files
COPY frontend/package*.json .

# Устанавливаем зависимости
RUN npm ci

# Копируем исходный код
COPY frontend/ .

# Переменные Vite встраиваются в бандл на этапе сборки.
# Пустой VITE_API_URL — запросы идут на относительный /api (nginx проксирует на бэкенд).
ARG VITE_API_URL=""
ARG VITE_CLOUDINARY_CLOUD_NAME=""
ARG VITE_CLOUDINARY_UPLOAD_PRESET=""
ENV VITE_API_URL=$VITE_API_URL \
    VITE_CLOUDINARY_CLOUD_NAME=$VITE_CLOUDINARY_CLOUD_NAME \
    VITE_CLOUDINARY_UPLOAD_PRESET=$VITE_CLOUDINARY_UPLOAD_PRESET

# Собираем приложение в dist папку
RUN npm run build

# Stage 2: Serve с Nginx
FROM nginx:alpine

# Удаляем default конфигурацию
RUN rm /etc/nginx/conf.d/default.conf

# Копируем нашу конфигурацию
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Копируем собранные файлы React в папку Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Открываем порт
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:80 || exit 1

# Запускаем Nginx
CMD ["nginx", "-g", "daemon off;"]
