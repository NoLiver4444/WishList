# Пример настроек для локального запуска бэкенда (make run / go run).
# Скопируйте в backend/.env и заполните.
PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wishpiece
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable
# Длинная случайная строка, например: openssl rand -hex 32
JWT_SECRET=
# Origin фронтенда для CORS (пусто — CORS-заголовки не отправляются)
CORS_ORIGIN=http://localhost:5173
