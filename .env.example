# Переменные для docker-compose. Скопируйте в .env (рядом с docker-compose.yml) и заполните.

# --- Обязательные ---
# Пароль PostgreSQL
DB_PASSWORD=
# Секрет подписи JWT — длинная случайная строка (например: openssl rand -hex 32)
JWT_SECRET=

# --- Необязательные ---
DB_USER=postgres
DB_NAME=wishpiece
DB_SSLMODE=disable
# Origin фронтенда для CORS. В docker-compose фронт и API на одном домене (nginx), поэтому
# достаточно значения по умолчанию.
CORS_ORIGIN=http://localhost

# --- Фронтенд (встраиваются в бандл при сборке образа) ---
# Пусто — фронт ходит на относительный /api через nginx.
VITE_API_URL=
# Cloudinary для загрузки картинок (unsigned upload preset). Без них — только ссылки на картинки.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
